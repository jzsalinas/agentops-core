{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.org/agentops/1/Incident.schema.json",
  "title": "Incident",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "AGENTOPS/1"
    },
    "kind": {
      "const": "Incident"
    },
    "id": {
      "type": "string",
      "pattern": "^urn:agentops:[a-z0-9-]+:incident:[A-Za-z0-9._-]+$",
      "maxLength": 240
    },
    "record_revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100000000
    },
    "project_id": {
      "type": "string",
      "pattern": "^urn:agentops:[a-z0-9-]+:project:[A-Za-z0-9._-]+$",
      "maxLength": 240
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "task_id": {
      "type": "string",
      "pattern": "^urn:agentops:[a-z0-9-]+:task:[A-Za-z0-9._-]+$",
      "maxLength": 240
    },
    "execution_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^urn:agentops:[a-z0-9-]+:execution:[A-Za-z0-9._-]+$",
          "maxLength": 240
        },
        {
          "type": "null"
        }
      ]
    },
    "attempt_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^urn:agentops:[a-z0-9-]+:attempt:[A-Za-z0-9._-]+$",
          "maxLength": 240
        },
        {
          "type": "null"
        }
      ]
    },
    "category": {
      "enum": [
        "ENVIRONMENT",
        "POLICY",
        "INTEGRITY",
        "STALE_SHA",
        "DELIVERY",
        "EXECUTOR",
        "PRIVACY",
        "BUDGET"
      ]
    },
    "severity": {
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH"
      ]
    },
    "effect_state": {
      "enum": [
        "NONE",
        "CONFIRMED",
        "UNKNOWN"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.example.org/agentops/1/common.schema.json#/$defs/evidence_ref"
      },
      "minItems": 0,
      "uniqueItems": true,
      "maxItems": 1000
    },
    "recovery_action_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^urn:agentops:[a-z0-9-]+:recovery:[A-Za-z0-9._-]+$",
        "maxLength": 240
      },
      "minItems": 0,
      "uniqueItems": true,
      "maxItems": 1000
    },
    "status": {
      "enum": [
        "OPEN",
        "RECONCILING",
        "RESOLVED",
        "ESCALATED"
      ]
    }
  },
  "required": [
    "schema_version",
    "kind",
    "id",
    "record_revision",
    "project_id",
    "created_at",
    "task_id",
    "execution_id",
    "attempt_id",
    "category",
    "severity",
    "effect_state",
    "summary",
    "evidence_refs",
    "recovery_action_ids",
    "status"
  ],
  "additionalProperties": false
}
