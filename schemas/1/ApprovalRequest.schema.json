{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.org/agentops/1/ApprovalRequest.schema.json",
  "title": "ApprovalRequest",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "AGENTOPS/1"
    },
    "kind": {
      "const": "ApprovalRequest"
    },
    "id": {
      "type": "string",
      "pattern": "^urn:agentops:[a-z0-9-]+:approval:[A-Za-z0-9._-]+$",
      "maxLength": 240
    },
    "record_revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100000000
    },
    "project_id": {
      "type": "string",
      "pattern": "^urn:agentops:[a-z0-9-]+:project:[A-Za-z0-9._-]+$",
      "maxLength": 240
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "requester_agent_id": {
      "type": "string",
      "pattern": "^urn:agentops:[a-z0-9-]+:agent:[A-Za-z0-9._-]+$",
      "maxLength": 240
    },
    "approver_owner_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^urn:agentops:[a-z0-9-]+:human:[A-Za-z0-9._-]+$",
        "maxLength": 240
      },
      "minItems": 1,
      "uniqueItems": true,
      "maxItems": 1000
    },
    "scope": {
      "$ref": "https://schemas.example.org/agentops/1/common.schema.json#/$defs/scope"
    },
    "policy_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "prepared_bundle": {
      "$ref": "https://schemas.example.org/agentops/1/common.schema.json#/$defs/evidence_ref"
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "status": {
      "enum": [
        "PENDING",
        "APPROVED",
        "DENIED",
        "EXPIRED",
        "REVOKED"
      ]
    },
    "decision_ref": {
      "anyOf": [
        {
          "type": "string",
          "format": "uri",
          "maxLength": 2048
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "kind",
    "id",
    "record_revision",
    "project_id",
    "created_at",
    "requester_agent_id",
    "approver_owner_ids",
    "scope",
    "policy_digest",
    "prepared_bundle",
    "reason",
    "expires_at",
    "status",
    "decision_ref"
  ],
  "additionalProperties": false
}
