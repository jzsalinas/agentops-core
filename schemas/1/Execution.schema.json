{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.org/agentops/1/Execution.schema.json",
  "title": "Execution",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "AGENTOPS/1"
    },
    "kind": {
      "const": "Execution"
    },
    "id": {
      "type": "string",
      "pattern": "^urn:agentops:[a-z0-9-]+:execution:[A-Za-z0-9._-]+$",
      "maxLength": 240
    },
    "record_revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100000000
    },
    "project_id": {
      "type": "string",
      "pattern": "^urn:agentops:[a-z0-9-]+:project:[A-Za-z0-9._-]+$",
      "maxLength": 240
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "task_id": {
      "type": "string",
      "pattern": "^urn:agentops:[a-z0-9-]+:task:[A-Za-z0-9._-]+$",
      "maxLength": 240
    },
    "task_revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100000000
    },
    "assignment_id": {
      "type": "string",
      "pattern": "^urn:agentops:[a-z0-9-]+:assignment:[A-Za-z0-9._-]+$",
      "maxLength": 240
    },
    "parent_execution_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^urn:agentops:[a-z0-9-]+:execution:[A-Za-z0-9._-]+$",
          "maxLength": 240
        },
        {
          "type": "null"
        }
      ]
    },
    "executor_id": {
      "type": "string",
      "pattern": "^urn:agentops:[a-z0-9-]+:executor:[A-Za-z0-9._-]+$",
      "maxLength": 240
    },
    "authorization_id": {
      "type": "string",
      "pattern": "^urn:agentops:[a-z0-9-]+:authorization:[A-Za-z0-9._-]+$",
      "maxLength": 240
    },
    "policy_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "resource": {
      "$ref": "https://schemas.example.org/agentops/1/common.schema.json#/$defs/resource"
    },
    "status": {
      "enum": [
        "NOT_SCHEDULED",
        "QUEUED",
        "CLAIMED",
        "RUNNING",
        "SUCCEEDED",
        "FAILED",
        "BLOCKED",
        "CANCELLED",
        "STALE",
        "EXPIRED"
      ]
    },
    "attempt_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^urn:agentops:[a-z0-9-]+:attempt:[A-Za-z0-9._-]+$",
        "maxLength": 240
      },
      "minItems": 0,
      "uniqueItems": true,
      "maxItems": 1000
    },
    "budget": {
      "$ref": "https://schemas.example.org/agentops/1/common.schema.json#/$defs/budget"
    },
    "cancel_requested": {
      "type": "boolean"
    }
  },
  "required": [
    "schema_version",
    "kind",
    "id",
    "record_revision",
    "project_id",
    "created_at",
    "task_id",
    "task_revision",
    "assignment_id",
    "parent_execution_id",
    "executor_id",
    "authorization_id",
    "policy_digest",
    "resource",
    "status",
    "attempt_ids",
    "budget",
    "cancel_requested"
  ],
  "additionalProperties": false
}
