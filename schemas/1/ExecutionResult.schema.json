{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.org/agentops/1/ExecutionResult.schema.json",
  "title": "ExecutionResult",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "AGENTOPS/1"
    },
    "kind": {
      "const": "ExecutionResult"
    },
    "id": {
      "type": "string",
      "pattern": "^urn:agentops:[a-z0-9-]+:result:[A-Za-z0-9._-]+$",
      "maxLength": 240
    },
    "record_revision": {
      "const": 1
    },
    "project_id": {
      "type": "string",
      "pattern": "^urn:agentops:[a-z0-9-]+:project:[A-Za-z0-9._-]+$",
      "maxLength": 240
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "task_id": {
      "type": "string",
      "pattern": "^urn:agentops:[a-z0-9-]+:task:[A-Za-z0-9._-]+$",
      "maxLength": 240
    },
    "task_revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100000000
    },
    "execution_id": {
      "type": "string",
      "pattern": "^urn:agentops:[a-z0-9-]+:execution:[A-Za-z0-9._-]+$",
      "maxLength": 240
    },
    "attempt_id": {
      "type": "string",
      "pattern": "^urn:agentops:[a-z0-9-]+:attempt:[A-Za-z0-9._-]+$",
      "maxLength": 240
    },
    "resource": {
      "$ref": "https://schemas.example.org/agentops/1/common.schema.json#/$defs/resource"
    },
    "outcome": {
      "enum": [
        "SUCCEEDED",
        "FAILED",
        "BLOCKED",
        "STALE",
        "CANCELLED"
      ]
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.example.org/agentops/1/common.schema.json#/$defs/evidence_ref"
      },
      "minItems": 1,
      "uniqueItems": true,
      "maxItems": 1000
    },
    "claims_supported": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4000
      },
      "minItems": 0,
      "uniqueItems": true,
      "maxItems": 1000
    },
    "claims_not_supported": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4000
      },
      "minItems": 1,
      "uniqueItems": true,
      "maxItems": 1000
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4000
      },
      "minItems": 0,
      "uniqueItems": true,
      "maxItems": 1000
    },
    "actual_external_effect_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri",
        "maxLength": 2048
      },
      "minItems": 0,
      "uniqueItems": true,
      "maxItems": 1000
    },
    "metrics": {
      "$ref": "https://schemas.example.org/agentops/1/common.schema.json#/$defs/metrics"
    },
    "required_human_actions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4000
      },
      "minItems": 0,
      "uniqueItems": true,
      "maxItems": 1000
    },
    "review_required": {
      "type": "boolean"
    }
  },
  "required": [
    "schema_version",
    "kind",
    "id",
    "record_revision",
    "project_id",
    "created_at",
    "task_id",
    "task_revision",
    "execution_id",
    "attempt_id",
    "resource",
    "outcome",
    "evidence_refs",
    "claims_supported",
    "claims_not_supported",
    "limitations",
    "actual_external_effect_refs",
    "metrics",
    "required_human_actions",
    "review_required"
  ],
  "additionalProperties": false
}
