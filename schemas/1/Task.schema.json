{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.org/agentops/1/Task.schema.json",
  "title": "Task",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "AGENTOPS/1"
    },
    "kind": {
      "const": "Task"
    },
    "id": {
      "type": "string",
      "pattern": "^urn:agentops:[a-z0-9-]+:task:[A-Za-z0-9._-]+$",
      "maxLength": 240
    },
    "record_revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100000000
    },
    "project_id": {
      "type": "string",
      "pattern": "^urn:agentops:[a-z0-9-]+:project:[A-Za-z0-9._-]+$",
      "maxLength": 240
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "task_revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100000000
    },
    "objective": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "requested_by": {
      "$ref": "https://schemas.example.org/agentops/1/common.schema.json#/$defs/party"
    },
    "target": {
      "$ref": "https://schemas.example.org/agentops/1/common.schema.json#/$defs/party"
    },
    "resource": {
      "$ref": "https://schemas.example.org/agentops/1/common.schema.json#/$defs/resource"
    },
    "action": {
      "$ref": "https://schemas.example.org/agentops/1/common.schema.json#/$defs/action"
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4000
      },
      "minItems": 1,
      "uniqueItems": true,
      "maxItems": 1000
    },
    "idempotency_key": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "correlation_id": {
      "type": "string",
      "pattern": "^urn:agentops:[a-z0-9-]+:task:[A-Za-z0-9._-]+$",
      "maxLength": 240
    },
    "trigger_event_id": {
      "type": "string",
      "pattern": "^urn:agentops:[a-z0-9-]+:event:[A-Za-z0-9._-]+$",
      "maxLength": 240
    },
    "deadline_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "budget": {
      "$ref": "https://schemas.example.org/agentops/1/common.schema.json#/$defs/budget"
    },
    "policy_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "states": {
      "$ref": "https://schemas.example.org/agentops/1/common.schema.json#/$defs/states"
    },
    "review_target": {
      "$ref": "https://schemas.example.org/agentops/1/common.schema.json#/$defs/party"
    }
  },
  "required": [
    "schema_version",
    "kind",
    "id",
    "record_revision",
    "project_id",
    "created_at",
    "task_revision",
    "objective",
    "requested_by",
    "target",
    "resource",
    "action",
    "acceptance_criteria",
    "idempotency_key",
    "correlation_id",
    "trigger_event_id",
    "deadline_at",
    "budget",
    "policy_digest",
    "states",
    "review_target"
  ],
  "additionalProperties": false
}
