{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.org/agentops/1/EvidenceBundle.schema.json",
  "title": "EvidenceBundle",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "AGENTOPS/1"
    },
    "kind": {
      "const": "EvidenceBundle"
    },
    "id": {
      "type": "string",
      "pattern": "^urn:agentops:[a-z0-9-]+:evidence:[A-Za-z0-9._-]+$",
      "maxLength": 240
    },
    "record_revision": {
      "const": 1
    },
    "project_id": {
      "type": "string",
      "pattern": "^urn:agentops:[a-z0-9-]+:project:[A-Za-z0-9._-]+$",
      "maxLength": 240
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "task_id": {
      "type": "string",
      "pattern": "^urn:agentops:[a-z0-9-]+:task:[A-Za-z0-9._-]+$",
      "maxLength": 240
    },
    "task_revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100000000
    },
    "execution_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^urn:agentops:[a-z0-9-]+:execution:[A-Za-z0-9._-]+$",
          "maxLength": 240
        },
        {
          "type": "null"
        }
      ]
    },
    "attempt_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^urn:agentops:[a-z0-9-]+:attempt:[A-Za-z0-9._-]+$",
          "maxLength": 240
        },
        {
          "type": "null"
        }
      ]
    },
    "resource": {
      "$ref": "https://schemas.example.org/agentops/1/common.schema.json#/$defs/resource"
    },
    "evidence_class": {
      "enum": [
        "AUTOMATED_LOCAL",
        "INSTRUMENTED",
        "PLATFORM_OBSERVATION",
        "HUMAN_REPORT",
        "DOCUMENTARY"
      ]
    },
    "observed_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "environment_summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "procedure": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4000
      },
      "minItems": 1,
      "uniqueItems": true,
      "maxItems": 1000
    },
    "result": {
      "enum": [
        "PASS",
        "FAIL",
        "PARTIAL",
        "NOT_RUN",
        "UNKNOWN"
      ]
    },
    "artifacts": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.example.org/agentops/1/common.schema.json#/$defs/artifact"
      },
      "minItems": 0,
      "uniqueItems": true,
      "maxItems": 1000
    },
    "claims_supported": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4000
      },
      "minItems": 0,
      "uniqueItems": true,
      "maxItems": 1000
    },
    "claims_not_supported": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4000
      },
      "minItems": 1,
      "uniqueItems": true,
      "maxItems": 1000
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4000
      },
      "minItems": 0,
      "uniqueItems": true,
      "maxItems": 1000
    },
    "supersedes_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^urn:agentops:[a-z0-9-]+:evidence:[A-Za-z0-9._-]+$",
        "maxLength": 240
      },
      "minItems": 0,
      "uniqueItems": true,
      "maxItems": 1000
    },
    "redactions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4000
      },
      "minItems": 0,
      "uniqueItems": true,
      "maxItems": 1000
    }
  },
  "required": [
    "schema_version",
    "kind",
    "id",
    "record_revision",
    "project_id",
    "created_at",
    "task_id",
    "task_revision",
    "execution_id",
    "attempt_id",
    "resource",
    "evidence_class",
    "observed_at",
    "environment_summary",
    "procedure",
    "result",
    "artifacts",
    "claims_supported",
    "claims_not_supported",
    "limitations",
    "supersedes_ids",
    "redactions"
  ],
  "additionalProperties": false
}
