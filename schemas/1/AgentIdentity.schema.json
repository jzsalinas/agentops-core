{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.org/agentops/1/AgentIdentity.schema.json",
  "title": "AgentIdentity",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "AGENTOPS/1"
    },
    "kind": {
      "const": "AgentIdentity"
    },
    "id": {
      "type": "string",
      "pattern": "^urn:agentops:[a-z0-9-]+:agent:[A-Za-z0-9._-]+$",
      "maxLength": 240
    },
    "record_revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100000000
    },
    "project_id": {
      "type": "string",
      "pattern": "^urn:agentops:[a-z0-9-]+:project:[A-Za-z0-9._-]+$",
      "maxLength": 240
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "team_id": {
      "type": "string",
      "pattern": "^urn:agentops:[a-z0-9-]+:team:[A-Za-z0-9._-]+$",
      "maxLength": 240
    },
    "owner_id": {
      "type": "string",
      "pattern": "^urn:agentops:[a-z0-9-]+:human:[A-Za-z0-9._-]+$",
      "maxLength": 240
    },
    "display_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "logical_role": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "provider_hint": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        {
          "type": "null"
        }
      ]
    },
    "runtime_binding_ref": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^urn:agentops:[a-z0-9-]+:executor:[A-Za-z0-9._-]+$",
          "maxLength": 240
        },
        {
          "type": "null"
        }
      ]
    },
    "identity_registry_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "required": [
    "schema_version",
    "kind",
    "id",
    "record_revision",
    "project_id",
    "created_at",
    "team_id",
    "owner_id",
    "display_name",
    "logical_role",
    "provider_hint",
    "runtime_binding_ref",
    "identity_registry_digest"
  ],
  "additionalProperties": false
}
