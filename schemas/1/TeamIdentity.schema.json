{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.org/agentops/1/TeamIdentity.schema.json",
  "title": "TeamIdentity",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "AGENTOPS/1"
    },
    "kind": {
      "const": "TeamIdentity"
    },
    "id": {
      "type": "string",
      "pattern": "^urn:agentops:[a-z0-9-]+:team:[A-Za-z0-9._-]+$",
      "maxLength": 240
    },
    "record_revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100000000
    },
    "project_id": {
      "type": "string",
      "pattern": "^urn:agentops:[a-z0-9-]+:project:[A-Za-z0-9._-]+$",
      "maxLength": 240
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "owner_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^urn:agentops:[a-z0-9-]+:human:[A-Za-z0-9._-]+$",
        "maxLength": 240
      },
      "minItems": 1,
      "uniqueItems": true,
      "maxItems": 1000
    },
    "member_agent_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^urn:agentops:[a-z0-9-]+:agent:[A-Za-z0-9._-]+$",
        "maxLength": 240
      },
      "minItems": 1,
      "uniqueItems": true,
      "maxItems": 1000
    },
    "display_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "identity_registry_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "required": [
    "schema_version",
    "kind",
    "id",
    "record_revision",
    "project_id",
    "created_at",
    "owner_ids",
    "member_agent_ids",
    "display_name",
    "identity_registry_digest"
  ],
  "additionalProperties": false
}
