{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.org/agentops/1/common.schema.json",
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^urn:agentops:[a-z0-9-]+:[a-z][a-z0-9-]*:[A-Za-z0-9._-]+$",
      "maxLength": 240
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "uri": {
      "type": "string",
      "format": "uri",
      "maxLength": 2048
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "git_sha": {
      "type": "string",
      "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "principal": {
      "type": "object",
      "properties": {
        "issuer": {
          "type": "string",
          "format": "uri",
          "maxLength": 2048
        },
        "subject": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        }
      },
      "required": [
        "issuer",
        "subject"
      ],
      "additionalProperties": false
    },
    "party": {
      "type": "object",
      "properties": {
        "agent_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^urn:agentops:[a-z0-9-]+:agent:[A-Za-z0-9._-]+$",
              "maxLength": 240
            },
            {
              "type": "null"
            }
          ]
        },
        "team_id": {
          "type": "string",
          "pattern": "^urn:agentops:[a-z0-9-]+:team:[A-Za-z0-9._-]+$",
          "maxLength": 240
        },
        "owner_id": {
          "type": "string",
          "pattern": "^urn:agentops:[a-z0-9-]+:human:[A-Za-z0-9._-]+$",
          "maxLength": 240
        }
      },
      "required": [
        "agent_id",
        "team_id",
        "owner_id"
      ],
      "additionalProperties": false
    },
    "resource": {
      "type": "object",
      "properties": {
        "resource_id": {
          "type": "string",
          "pattern": "^urn:agentops:[a-z0-9-]+:resource:[A-Za-z0-9._-]+$",
          "maxLength": 240
        },
        "repository_ref": {
          "type": "string",
          "format": "uri",
          "maxLength": 2048
        },
        "revision": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
            },
            {
              "type": "null"
            }
          ]
        },
        "revision_status": {
          "enum": [
            "PINNED",
            "UNKNOWN"
          ]
        },
        "paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "minItems": 1,
          "uniqueItems": true,
          "maxItems": 1000
        }
      },
      "required": [
        "resource_id",
        "repository_ref",
        "revision",
        "revision_status",
        "paths"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "revision_status": {
                "const": "PINNED"
              }
            }
          },
          "then": {
            "properties": {
              "revision": {
                "type": "string",
                "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
              }
            }
          },
          "else": {
            "properties": {
              "revision": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "budget": {
      "type": "object",
      "properties": {
        "max_attempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "wall_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        },
        "max_tokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "max_cost_minor": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "max_external_effects": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "max_hops": {
          "type": "integer",
          "minimum": 0,
          "maximum": 6
        },
        "max_no_progress_exchanges": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2
        }
      },
      "required": [
        "max_attempts",
        "wall_seconds",
        "max_tokens",
        "max_cost_minor",
        "currency",
        "max_external_effects",
        "max_hops",
        "max_no_progress_exchanges"
      ],
      "additionalProperties": false
    },
    "states": {
      "type": "object",
      "properties": {
        "receipt": {
          "enum": [
            "RECORDED",
            "ACKNOWLEDGED",
            "QUARANTINED",
            "REJECTED"
          ]
        },
        "execution": {
          "enum": [
            "NOT_SCHEDULED",
            "QUEUED",
            "CLAIMED",
            "RUNNING",
            "SUCCEEDED",
            "FAILED",
            "BLOCKED",
            "CANCELLED",
            "STALE",
            "EXPIRED"
          ]
        },
        "review": {
          "enum": [
            "NOT_REQUESTED",
            "PENDING",
            "CHANGES_REQUESTED",
            "ACCEPTED",
            "REJECTED",
            "STALE"
          ]
        },
        "authorization": {
          "enum": [
            "NOT_EVALUATED",
            "PENDING",
            "GRANTED",
            "DENIED",
            "EXPIRED",
            "REVOKED",
            "CONSUMED"
          ]
        },
        "publication": {
          "enum": [
            "NOT_REQUESTED",
            "PENDING",
            "SENDING",
            "CONFIRMED",
            "UNKNOWN",
            "FAILED"
          ]
        },
        "closure": {
          "enum": [
            "OPEN",
            "CLOSED",
            "SUPERSEDED"
          ]
        }
      },
      "required": [
        "receipt",
        "execution",
        "review",
        "authorization",
        "publication",
        "closure"
      ],
      "additionalProperties": false
    },
    "evidence_ref": {
      "type": "object",
      "properties": {
        "bundle_id": {
          "type": "string",
          "pattern": "^urn:agentops:[a-z0-9-]+:evidence:[A-Za-z0-9._-]+$",
          "maxLength": 240
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "bundle_id",
        "digest"
      ],
      "additionalProperties": false
    },
    "artifact": {
      "type": "object",
      "properties": {
        "artifact_id": {
          "type": "string",
          "pattern": "^urn:agentops:[a-z0-9-]+:artifact:[A-Za-z0-9._-]+$",
          "maxLength": 240
        },
        "uri": {
          "type": "string",
          "format": "uri",
          "maxLength": 2048
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "media_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10485760
        }
      },
      "required": [
        "artifact_id",
        "uri",
        "digest",
        "media_type",
        "bytes"
      ],
      "additionalProperties": false
    },
    "legacy": {
      "type": "object",
      "properties": {
        "protocol": {
          "const": "EXAMPLE-HANDOFF/1"
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "message_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000000
        },
        "in_reply_to": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000
            },
            {
              "type": "null"
            }
          ]
        },
        "source_url": {
          "type": "string",
          "format": "uri",
          "maxLength": 2048
        },
        "source_object_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "source_updated_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"
        },
        "observed_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"
        },
        "body_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "snapshot_ref": {
          "type": "string",
          "format": "uri",
          "maxLength": 2048
        },
        "parser_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "losses": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "minItems": 0,
          "uniqueItems": true,
          "maxItems": 1000
        },
        "declared_from": {
          "type": "object"
        },
        "declared_to": {
          "type": "object"
        },
        "declared_context": {
          "type": "object"
        },
        "declared_evidence": {
          "type": [
            "object",
            "array"
          ]
        },
        "declared_task": {
          "type": "string",
          "format": "uri",
          "maxLength": 2048
        }
      },
      "required": [
        "protocol",
        "request_id",
        "message_id",
        "revision",
        "in_reply_to",
        "source_url",
        "source_object_id",
        "source_updated_at",
        "observed_at",
        "body_digest",
        "snapshot_ref",
        "parser_version",
        "losses",
        "declared_from",
        "declared_to",
        "declared_context",
        "declared_evidence",
        "declared_task"
      ],
      "additionalProperties": false
    },
    "metrics": {
      "type": "object",
      "properties": {
        "wall_seconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000000
        },
        "tokens": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 100000000
            },
            {
              "type": "null"
            }
          ]
        },
        "cost_minor": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 100000000
            },
            {
              "type": "null"
            }
          ]
        },
        "external_effects": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        }
      },
      "required": [
        "wall_seconds",
        "tokens",
        "cost_minor",
        "external_effects"
      ],
      "additionalProperties": false
    },
    "scope": {
      "type": "object",
      "properties": {
        "task_id": {
          "type": "string",
          "pattern": "^urn:agentops:[a-z0-9-]+:task:[A-Za-z0-9._-]+$",
          "maxLength": 240
        },
        "task_revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000000
        },
        "resource": {
          "$ref": "https://schemas.example.org/agentops/1/common.schema.json#/$defs/resource"
        },
        "actions": {
          "type": "array",
          "items": {
            "enum": [
              "analyze_read_only",
              "publish_result",
              "review_result"
            ]
          },
          "minItems": 1,
          "uniqueItems": true,
          "maxItems": 1000
        },
        "artifact_digests": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "minItems": 0,
          "uniqueItems": true,
          "maxItems": 1000
        },
        "max_effects": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        }
      },
      "required": [
        "task_id",
        "task_revision",
        "resource",
        "actions",
        "artifact_digests",
        "max_effects"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "actions": {
                "contains": {
                  "const": "publish_result"
                }
              }
            }
          },
          "then": {
            "properties": {
              "artifact_digests": {
                "minItems": 1
              },
              "max_effects": {
                "minimum": 1
              }
            }
          }
        }
      ]
    },
    "action": {
      "enum": [
        "analyze_read_only",
        "publish_result",
        "review_result"
      ]
    },
    "handoff_type": {
      "enum": [
        "REVIEW_REQUIRED",
        "ACKNOWLEDGED",
        "CHANGES_REQUESTED",
        "READY_FOR_REVIEW",
        "BLOCKED",
        "DECISION_REQUIRED",
        "CLOSED"
      ]
    }
  }
}
