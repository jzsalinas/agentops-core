{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.org/agentops/1/TaskAssignment.schema.json",
  "title": "TaskAssignment",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "AGENTOPS/1"
    },
    "kind": {
      "const": "TaskAssignment"
    },
    "id": {
      "type": "string",
      "pattern": "^urn:agentops:[a-z0-9-]+:assignment:[A-Za-z0-9._-]+$",
      "maxLength": 240
    },
    "record_revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100000000
    },
    "project_id": {
      "type": "string",
      "pattern": "^urn:agentops:[a-z0-9-]+:project:[A-Za-z0-9._-]+$",
      "maxLength": 240
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "task_id": {
      "type": "string",
      "pattern": "^urn:agentops:[a-z0-9-]+:task:[A-Za-z0-9._-]+$",
      "maxLength": 240
    },
    "task_revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100000000
    },
    "agent_id": {
      "type": "string",
      "pattern": "^urn:agentops:[a-z0-9-]+:agent:[A-Za-z0-9._-]+$",
      "maxLength": 240
    },
    "executor_id": {
      "type": "string",
      "pattern": "^urn:agentops:[a-z0-9-]+:executor:[A-Za-z0-9._-]+$",
      "maxLength": 240
    },
    "execution_id": {
      "type": "string",
      "pattern": "^urn:agentops:[a-z0-9-]+:execution:[A-Za-z0-9._-]+$",
      "maxLength": 240
    },
    "lease_token": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "fencing_token": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100000000
    },
    "lease_expires_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "exclusive_resource_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^urn:agentops:[a-z0-9-]+:resource:[A-Za-z0-9._-]+$",
        "maxLength": 240
      },
      "minItems": 1,
      "uniqueItems": true,
      "maxItems": 1000
    },
    "authorization_id": {
      "type": "string",
      "pattern": "^urn:agentops:[a-z0-9-]+:authorization:[A-Za-z0-9._-]+$",
      "maxLength": 240
    }
  },
  "required": [
    "schema_version",
    "kind",
    "id",
    "record_revision",
    "project_id",
    "created_at",
    "task_id",
    "task_revision",
    "agent_id",
    "executor_id",
    "execution_id",
    "lease_token",
    "fencing_token",
    "lease_expires_at",
    "exclusive_resource_ids",
    "authorization_id"
  ],
  "additionalProperties": false
}
