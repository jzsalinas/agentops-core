{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.org/agentops/1/ExecutionAttempt.schema.json",
  "title": "ExecutionAttempt",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "AGENTOPS/1"
    },
    "kind": {
      "const": "ExecutionAttempt"
    },
    "id": {
      "type": "string",
      "pattern": "^urn:agentops:[a-z0-9-]+:attempt:[A-Za-z0-9._-]+$",
      "maxLength": 240
    },
    "record_revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100000000
    },
    "project_id": {
      "type": "string",
      "pattern": "^urn:agentops:[a-z0-9-]+:project:[A-Za-z0-9._-]+$",
      "maxLength": 240
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "execution_id": {
      "type": "string",
      "pattern": "^urn:agentops:[a-z0-9-]+:execution:[A-Za-z0-9._-]+$",
      "maxLength": 240
    },
    "attempt_number": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3
    },
    "fencing_token": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100000000
    },
    "started_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "ended_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "enum": [
        "RUNNING",
        "SUCCEEDED",
        "FAILED",
        "BLOCKED",
        "UNKNOWN",
        "CANCELLED",
        "STALE"
      ]
    },
    "failure_code": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        {
          "type": "null"
        }
      ]
    },
    "metrics": {
      "$ref": "https://schemas.example.org/agentops/1/common.schema.json#/$defs/metrics"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.example.org/agentops/1/common.schema.json#/$defs/evidence_ref"
      },
      "minItems": 0,
      "uniqueItems": true,
      "maxItems": 1000
    }
  },
  "required": [
    "schema_version",
    "kind",
    "id",
    "record_revision",
    "project_id",
    "created_at",
    "execution_id",
    "attempt_number",
    "fencing_token",
    "started_at",
    "ended_at",
    "status",
    "failure_code",
    "metrics",
    "evidence_refs"
  ],
  "additionalProperties": false
}
